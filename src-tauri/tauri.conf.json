{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KeyTone",
  "version": "0.1.0",
  "identifier": "com.keytone.app",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "KeyTone",
        "width": 900,
        "height": 660,
        "minWidth": 780,
        "minHeight": 580,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ]
  }
}
