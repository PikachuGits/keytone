{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KeyTone",
  "version": "0.3.0",
  "identifier": "com.keytone.app",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "KeyTone",
        "width": 900,
        "height": 660,
        "minWidth": 780,
        "minHeight": 580,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "Utility",
    "shortDescription": "键盘与鼠标音效引擎",
    "longDescription": "把每一次敲击和点击都变成声音。常驻菜单栏，全局捕获键盘与鼠标事件，支持独立音色包、多采样随机与键位语音播报。",
    "copyright": "Copyright © 2026 PikachuGits",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "KeyTone Local Signing"
    }
  }
}
